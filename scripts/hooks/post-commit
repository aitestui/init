#!/usr/bin/env bash
# skills 仓库提交后：若本次提交改动了 skills/aitestui/，用 HEAD 的内容重建官网 zip。
# 安装：bash scripts/install-git-hook.sh（会在本仓库 .git/hooks 建一个指向本文件的软链）。
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$HOOK_DIR/../.." && pwd -P)"
SKILL_PATH="skills/aitestui"
OUT_DIR="$(cd "$REPO_ROOT/.." && pwd -P)/fe_aitestui/public/skills"

# --root/-m 覆盖首次提交与 merge；只看 HEAD 这一笔，不扫历史。
if ! git -C "$REPO_ROOT" diff-tree --root -m --no-commit-id --name-only -r HEAD -- "$SKILL_PATH" | grep -q .; then
  exit 0
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# 从 HEAD 导出而不是读工作区，避免把未提交的本地改动打进 zip。
git -C "$REPO_ROOT" archive HEAD "$SKILL_PATH" | tar -x -C "$TMP"
SRC="$TMP/$SKILL_PATH"
if [ ! -d "$SRC" ]; then
  echo "post-commit: HEAD 中已无 $SKILL_PATH，跳过 zip 生成" >&2
  exit 0
fi

bash "$REPO_ROOT/scripts/build-web-zip.sh" "$OUT_DIR" "$SRC"
